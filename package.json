  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --ci --coverage",
    "prebuild": "expo prebuild --clean",
    "eas:config": "npx eas-cli@latest config --platform android",
    "eas:build:dev": "npx eas-cli@latest build --profile development --platform android",
    "eas:build:preview": "npx eas-cli@latest build --profile preview --platform android",
    "eas:build:prod": "npx eas-cli@latest build --profile production --platform all",
    "eas:submit": "npx eas-cli@latest submit --profile production --platform android",
    "validate:eas": "node scripts/validate-eas-json.cjs",
    "validate:workflow": "node scripts/validate-workflow.cjs",
    "secret:github": "node scripts/set-github-secret.mjs",
    "eas:setup": "node scripts/setup-eas-token.mjs",
    "eas:check-token": "node scripts/check-expo-token.mjs"
